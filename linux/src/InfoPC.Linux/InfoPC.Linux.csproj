<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>InfoPC</AssemblyName>
    <RootNamespace>InfoPC.Linux</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPC.Core\InfoPC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPC.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\..\Assets\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\..\Assets\logo-dark.png" Link="Assets\logo-dark.png" />
  </ItemGroup>

</Project>
