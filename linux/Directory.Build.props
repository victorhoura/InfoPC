<Project>
  <!-- Configuracao comum da edicao Linux (so vale para projetos dentro de linux\). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Version>1.1.8</Version>
    <Product>InfoPC</Product>
    <Company>InfoPC</Company>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sem ICU: distros minimas nao trazem libicu e o .NET nao abriria. A formatacao pt-BR e feita em Locale.cs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
